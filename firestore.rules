rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // app_styles - Public access for "anybody to edit"
    match /app_styles/{styleId} {
      allow read, write: if true;
    }

    // app_categories - Public access for "anybody to edit"
    match /app_categories/{catId} {
      allow read, write: if true;
    }

    // portfolio - Public access for "anybody to edit"
    match /portfolio/{projectId} {
      allow read, write: if true;
    }

    // users - keep as is or just allow read if needed
    match /users/{userId} {
      allow read, write: if true;
    }

    // designs
    match /designs/{designId} {
      allow read, write: if true;
    }

    // visits
    match /visits/{visitId} {
      allow read, write: if true;
    }
  }
}
